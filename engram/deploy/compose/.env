# Image pins of the dev compose (PLAN.md section 9.2 toolchain pins: never float). Every external image is pinned by
# digest; the tag in the comment is what the digest was resolved from on 2026-10-09. Override per shell or in
# scripts/e2e.sh when a registry is rate limited (the same digest from mirror.gcr.io is the same image).
COMPOSE_PROFILES=core,catalog,shard,edge
# paradedb/paradedb:latest-pg16 (PostgreSQL 16.15, pg_search 0.26.0, pgvector 0.8.6)
SHARD_PG_BASE=paradedb/paradedb@sha256:7aba4dbac45cfcaaaddce50feb7081b3fc907061834c68b52a23aa7b66442b76
# postgres:16.15-alpine3.24, the base of the catalog and temporal-postgres images
PG_PLAIN_BASE=postgres@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea
# temporalio/server:1.31.3 and temporalio/admin-tools:1.31.3
TEMPORAL_SERVER_IMAGE=temporalio/server@sha256:b4a78d2186e558aa3502be08d576086c3a82fccdf6184cb4c819eb27bea7bd63
TEMPORAL_ADMIN_IMAGE=temporalio/admin-tools@sha256:76a70ead160808b54acdbc98944dfc07990d9637dda999118a2d9ee1f58b9bc9
# envoyproxy/envoy:v1.39.3
ENVOY_IMAGE=envoyproxy/envoy@sha256:dd85940439de19a0b6ae8419610363ea0ad351d9a994ea007161c206ec1e1865
# cgr.dev/chainguard/minio:latest (minio/minio is no longer published on Docker Hub or Quay; see the M0.4 report)
MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:f74600a1a46330cdbda1ef760d17a96bd6e0f4a6f0a2c49792ca3ee7e4c6fa18
# pgBackRest package versions, one per base distribution (the Dockerfile refuses to build without one)
SHARD_PGBACKREST_VERSION=2.59.3-1.pgdg13+1
PLAIN_PGBACKREST_VERSION=2.58.0-r0
# `https` normally; `http` behind a TLS-intercepting proxy (apk still verifies package signatures)
APK_SCHEME=https
